# ─────────────────────────────────────────────────────────────
# VyOS Companion - Environment Configuration (.env)
# ─────────────────────────────────────────────────────────────

# Web dashboard port accessed from the browser on the server
APP_PORT=8081

# true  = simulation/demo mode without a real router
# false = direct SSH connection to VyOS
DEMO_MODE=true

# VyOS router IP (make sure the server can reach this IP)
VYOS_HOST=192.168.1.1
VYOS_PORT=22

# VyOS SSH credentials (user with configure / show permission)
VYOS_USER=vyos
VYOS_PASS=vyos

# SSH connection timeout (seconds)
SSH_TIMEOUT=10
